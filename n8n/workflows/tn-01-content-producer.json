{
  "id": "tn-01-content-producer",
  "name": "TN-01 Daily Content Producer",
  "meta": {
    "description": "Every 15 min: atomically claims the next due slot (Africa/Tunis schedule), picks a destination, generates a photorealistic image (Gemini) or enhances a licensed photo, validates + hashes + stores it (tn-core), audits it with Claude vision, writes the Derja-first/English caption (Claude), applies deterministic gates, and schedules one shared post with a publication row per enabled platform. Any failure parks the slot: retry (bounded by slot_max_attempts), needs_review or skipped — never published. Publishing is a separate workflow behind the kill switch."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "every-15-minutes",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
