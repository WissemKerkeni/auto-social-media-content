# =============================================================================
# Tunisia Nature Content Automation — LOCAL DEVELOPMENT environment template
#
#   Create your real .env with:   npm run setup
#   (copies this file, fills every __GENERATE__ with a random secret and derives
#    DATABASE_URL; it NEVER overwrites an existing .env)
#
#   Validate it with:             npm run check-env
#
# Rules:
#   * .env is git-ignored. Never commit real values.
#   * Production uses a separate file (.env.production, see docs/deployment/).
#   * Platform access tokens (Facebook/Instagram/TikTok) live in n8n credentials
#     or the app's encrypted token store, not here.
#   * Existing .env missing new variables?  npm run setup -- --add-missing
#     (appends only the missing ones, generating secrets; never changes existing values)
# =============================================================================

# ---- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=tn-nature
# Optional docker compose profiles (comma-separated).
#   langfuse = local self-hosted Langfuse v4 (web, worker, ClickHouse, Redis), ~2–3 GB RAM.
# Leave empty to use Langfuse Cloud instead (then set LANGFUSE_BASE_URL/HOST_URL + keys below).
COMPOSE_PROFILES=langfuse
TZ=Africa/Tunis
GENERIC_TIMEZONE=Africa/Tunis

# ---- PostgreSQL (local Docker) -----------------------------------------------
# One server, two databases: n8n's internal DB and the application DB.
# Host port 5433 avoids clashing with a natively installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=__GENERATE__

APP_DB_NAME=tn_content
APP_DB_USER=tn_app
APP_DB_PASSWORD=__GENERATE__

# Host-side connection string for Prisma CLI / tests (derived by `npm run setup`).
# If you change APP_DB_* above, update this too.
DATABASE_URL=__DERIVED__

# ---- n8n ----------------------------------------------------------------------
N8N_HOST_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
# Local dev runs over plain http, so secure cookies must be off. Set true in production (https).
N8N_SECURE_COOKIE=false
N8N_LOG_LEVEL=info
# Encrypts credentials stored in n8n. BACK THIS UP. Losing it = losing all n8n credentials.
# Changing it on an existing n8n volume makes n8n refuse to start ("Mismatching encryption keys").
N8N_ENCRYPTION_KEY=__GENERATE__
# Hours to keep execution history (cost control for DB storage). 336 h = 14 days.
EXECUTIONS_DATA_MAX_AGE=336
# Owner account created by `npm run bootstrap:n8n` (local login for http://localhost:5678).
N8N_OWNER_EMAIL=owner@tn-nature.local
N8N_OWNER_PASSWORD=__GENERATE__

# ---- Langfuse (prompt management + LLM tracing) --------------------------------
# Runtime source of truth for prompts. Templates live in prompts/ and are pushed by
# `npm run seed-prompts`; n8n fetches the `production` label at run time.
# URL n8n uses (inside the Docker network). Local profile: http://langfuse-web:3000
# Langfuse Cloud (EU): https://cloud.langfuse.com
LANGFUSE_BASE_URL=http://langfuse-web:3000
# URL host-side scripts use (seed-prompts, bootstrap self-check, doctor).
LANGFUSE_HOST_URL=http://localhost:3000
# Project API keys. Local profile: generated here and provisioned headlessly on first boot.
# Langfuse Cloud: replace with the keys from Project Settings → API Keys.
LANGFUSE_PUBLIC_KEY=__GENERATE__
LANGFUSE_SECRET_KEY=__GENERATE__

# -- Local self-hosted Langfuse only (COMPOSE_PROFILES=langfuse) --
LANGFUSE_HOST_PORT=3000
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=__GENERATE__
LANGFUSE_NEXTAUTH_SECRET=__GENERATE__
LANGFUSE_SALT=__GENERATE__
# 64 hex chars. Encrypts LLM connection secrets stored in Langfuse. Back it up.
LANGFUSE_ENCRYPTION_KEY=__GENERATE__
LANGFUSE_CLICKHOUSE_PASSWORD=__GENERATE__
LANGFUSE_REDIS_PASSWORD=__GENERATE__
# Bucket in the local S3 (SeaweedFS) for Langfuse event/media blobs.
LANGFUSE_S3_BUCKET=langfuse
# Headless init: org/project/user + the API keys above are created on first boot.
LANGFUSE_INIT_ORG_ID=tn-nature
LANGFUSE_INIT_ORG_NAME=TN Nature
LANGFUSE_INIT_PROJECT_ID=tn-nature-dev
LANGFUSE_INIT_PROJECT_NAME=tn-nature-dev
LANGFUSE_INIT_USER_EMAIL=admin@tn-nature.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=__GENERATE__

# ---- tn-core (internal content service called by n8n) -------------------------
# Bearer token n8n uses to call tn-core (becomes the n8n credential "tn-core").
TN_CORE_TOKEN=__GENERATE__
TN_CORE_HOST_PORT=8081

# ---- Object storage (local: SeaweedFS S3 gateway; production: Cloudflare R2) --
S3_HOST_PORT=8333
# Endpoint as seen from other containers. Host-side tools use http://localhost:${S3_HOST_PORT}
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=auto
S3_BUCKET=tn-nature-media
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=__GENERATE__
S3_SECRET_ACCESS_KEY=__GENERATE__
# Public base URL that social platforms will fetch images from.
# Locally this is NOT reachable by Meta/TikTok servers; real publishing needs R2 + public URL.
S3_PUBLIC_BASE_URL=http://localhost:8333/tn-nature-media

# ---- Text model: Anthropic Claude (captions, Derja + English) -------------------
# Paste your key into your local .env only. Never into source, workflows, or Git.
# bootstrap:n8n turns it into n8n credentials (header x-api-key); n8n never sees it as an env var.
ANTHROPIC_API_KEY=
# Claude Opus 5.5: $4 / $20 per MTok, cache reads $0.20. Thinking is always on;
# ANTHROPIC_EFFORT (low|medium|high|xhigh|max) controls depth and cost. Opus 5.5 defaults to medium.
ANTHROPIC_TEXT_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Vision audit of each generated image (cheap; vision reads accurately at low effort).
ANTHROPIC_AUDIT_EFFORT=low
ANTHROPIC_MAX_TOKENS=16000
# Hard daily ceiling on ALL Claude calls (image audit + caption): 8 posts x 2 calls + retries.
# Enforced atomically in the database before every call.
ANTHROPIC_MAX_TEXT_CALLS_PER_DAY=30

# ---- Image model: Google Gemini (Nano Banana) ------------------------------------
GEMINI_API_KEY=
# gemini-nano-banana-2.1: stable; text-to-image AND image editing (multi-turn consistency);
# $0.0336 per 1K image / $0.0504 per 2K; Batch API is half price. No free tier for image models.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Uppercase K is required by the API. 2K at 4:5 clears Instagram's 1080 px width.
GEMINI_IMAGE_SIZE=2K
GEMINI_IMAGE_ASPECT_RATIO=4:5
GEMINI_MAX_IMAGE_CALLS_PER_DAY=12

# ---- Schedule (Africa/Tunis) ------------------------------------------------------
# Every PUBLISH_INTERVAL_MINUTES from START to END inclusive.
# 07:00–21:00 every 120 min => 07,09,11,13,15,17,19,21 (8 slots/day).
PUBLISH_TIMEZONE=Africa/Tunis
PUBLISH_WINDOW_START=07:00
PUBLISH_WINDOW_END=21:00
PUBLISH_INTERVAL_MINUTES=120
DAILY_POST_CAP=8
# Hours before the same destination may be featured again. 22 destinations at 8 posts/day
# rotate every ~66 h, so 48 h always leaves eligible destinations.
DESTINATION_COOLDOWN_HOURS=48

# ---- Safety -------------------------------------------------------------------------
# Global kill switch. false = produce/queue content but publish NOTHING.
# Keep false until platform credentials are configured and tested.
PUBLISHING_ENABLED=false
# Comma-separated subset of: facebook,instagram,tiktok
# TikTok stays off until its Content Posting API audit/authorization is confirmed.
ENABLED_PLATFORMS=facebook,instagram
